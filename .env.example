# Copy to .env (docker compose reads it automatically). Never commit .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
DJANGO_DEBUG=false
DJANGO_ENV=development            # set to "production" to refuse the dev secret key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL (shared by the db and web services) ---
POSTGRES_DB=ticketing
POSTGRES_USER=ticketing
POSTGRES_PASSWORD=change-me

# --- Business rules ---
RESERVATION_HOLD_MINUTES=15
MAX_SEATS_PER_RESERVATION=10

# --- Container behaviour ---
RUN_MIGRATIONS=1
SEED_DEMO_DATA=1                  # dev only: creates admin/alice demo accounts
